# Dev local : postgres / root
# Docker  : voir docker-compose.yml (utilisateur adoul)
DATABASE_URL=postgresql://postgres:root@localhost:5432/adoul_ai

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=adoul_knowledge

# Email (SMTP) — à configurer dans backend/.env
# Gmail : mot de passe d'application sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=raouf.abdelhafid.contact@gmail.com
SMTP_PASSWORD=drttnsjptwvpfcfe
MAIL_FROM=raouf.abdelhafid.contact@gmail.com
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Backend CORS — * = toutes origines (dev). Production : liste explicite
CORS_ORIGINS=*
FLASK_PORT=5001
API_PUBLIC_URL=http://localhost:5001

# Flask
FLASK_ENV=development
SECRET_KEY=flask-secret-change-me
