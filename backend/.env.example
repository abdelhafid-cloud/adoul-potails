# Copier vers backend/.env pour le dev local
# Dev local Windows (PostgreSQL installé)
DATABASE_URL=postgresql://postgres:root@localhost:5432/adoul_ai
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
SECRET_KEY=flask-secret-change-me
FLASK_ENV=development
FLASK_PORT=5001
# CORS — * autorise toutes les origines en dev local
CORS_ORIGINS=*
FRONTEND_URL=http://localhost:3000

# --- SMTP (obligatoire pour recevoir les emails) ---
# Gmail : créez un "Mot de passe d'application" sur https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM=votre.email@gmail.com
# SMTP_USE_TLS=true

OPENAI_API_KEY=
FLOWISE_API_URL=http://localhost:3000
FLOWISE_CHATFLOW_ID=
FLOWISE_API_KEY=